generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Quote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  inputs    Json
  result    Json
  dispatch  Dispatch?

  // Revising a quote creates a new row linked back to the original rather
  // than mutating it in place, so an accepted quote's history is never
  // silently rewritten.
  revisedFromId String?
  revisedFrom   Quote?   @relation("QuoteRevisions", fields: [revisedFromId], references: [id])
  revisions     Quote[]  @relation("QuoteRevisions")
}

model Dispatch {
  id                  String   @id @default(cuid())
  quoteId             String   @unique
  quote               Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  driver              String
  truck               String
  startTime           String
  customerContact     String
  specialInstructions String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
