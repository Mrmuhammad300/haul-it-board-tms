# Copy this file to .env and fill in real values for local development.
# In Vercel, set these as Project Environment Variables instead of
# committing a .env file.

# Postgres connection string (Vercel Postgres / Neon / local Postgres all work).
DATABASE_URL="postgresql://user:password@localhost:5432/dmlogistics"

# Auth.js (NextAuth v5) session signing secret. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# The canonical URL this app is served from. Vercel sets VERCEL_URL
# automatically for preview deployments; set this explicitly for your
# production domain and for local dev (http://localhost:3000).
NEXTAUTH_URL="http://localhost:3000"

# --- Optional: live national data sources (fast-follow, not wired into the
# UI yet - see README "Connecting live data sources"). The app runs fine
# with none of these set; it just falls back to manual entry.
EIA_API_KEY=""
GOOGLE_MAPS_API_KEY=""
NWS_USER_AGENT="dm-logistics-quote-calc (ops@yourcompany.com)"
